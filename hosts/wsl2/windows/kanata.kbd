;; Kanata keymap for the Windows host underneath WSL2. It ports the tap/hold
;; rules from hosts/macbook/karabiner/karabiner.json and adds a Space-held
;; Windows key for the GlazeWM bindings in glazewm.nix.
;;
;; Validate with:  kanata --check --cfg kanata.kbd
;; Use the Windows build: other builds skip Windows-only defcfg options. The
;; options here follow the Kanata release WinGet installs (1.12.x), not the
;; docs on its main branch.

(defcfg
  ;; Pass every key not listed in defsrc through unchanged.
  process-unmapped-keys yes
  ;; GlazeWM's own keyboard hook consumes the keys of its bindings (the 1 in
  ;; Space+1, sent as Win+1), so Windows never sees them pressed. Kanata 1.12
  ;; then logs "Unexpected keycode is pressed in kanata but not in Windows"
  ;; and clears that key's state. The check always runs in 1.12 and only
  ;; clears the consumed key, not the held Space, so the message is expected.
  ;; The tray build would also raise a system notification for each of those
  ;; logs. Keep them in the log only.
  notify-error no
)

(defsrc
  esc
  tab
  caps
  spc
)

(defvar
  tap-timeout 200
  hold-timeout 200
  ;; Space is pressed constantly while typing. A Space pressed within
  ;; space-prior-idle of another key resolves as Space at once, which keeps
  ;; the short hold timeout from turning typing pauses into Win.
  space-hold-timeout 200
  space-prior-idle 150
)

(defvirtualkeys
  ;; Win for a Space held past its timeout (see the spc alias).
  space-win lmet
  ;; Tap Ctrl, then release Win. Not F24 as the mask: on this machine Win+F24
  ;; briefly dims the screen. Not VK 0xE8: Kanata reserves it internally for
  ;; numpad Enter.
  space-win-release (macro lctl (on-press release-vkey space-win))
)

(defalias
  ;; Caps Lock: tap for Escape, hold for Control.
  ;; Shift+Caps (left) is Page Down; Shift+Caps (right) opens Task View, the
  ;; Windows counterpart to Mission Control.
  cap (tap-hold-press $tap-timeout $hold-timeout esc lctl)
  caps (fork
    (fork @cap (unshift pgdn) (lsft))
    (unmod lmet tab)
    (rsft))

  ;; Escape: tap for Escape, hold for Hyper. Windows reserves
  ;; Ctrl+Alt+Shift+Win for Office, so Hyper here is Ctrl+Alt+Shift.
  esc (tap-hold-press $tap-timeout $hold-timeout esc
    (multi lctl lalt lsft (layer-while-held hyper)))

  ;; Space: tap for Space, hold for the Windows key (GlazeWM's modifier).
  ;; The hold activates once another key is pressed and released, so typing
  ;; rolls (Space released first) stay Space. That hold is plain Win: the
  ;; other key already keeps Win from opening the Start menu on release.
  ;; Held past the timeout instead, Space presses Win through a virtual key,
  ;; and releasing Space taps Ctrl before releasing Win so a lone Win does not
  ;; open the Start menu (AutoHotkey's classic "menu mask"). The mask must
  ;; wait for the release: Kanata replays queued keys one per tick, so a Ctrl
  ;; tap sent when the hold activates overlaps the replayed key and turns
  ;; Win+Q into Win+Ctrl+Q.
  spc (tap-hold-release-timeout $tap-timeout $space-hold-timeout spc lmet
    (multi
      (on-press press-vkey space-win)
      (on-release tap-vkey space-win-release))
    (require-prior-idle $space-prior-idle))

  ;; Hyper+Tab sends Shift+F1, the tmux prefix used on the Mac.
  hyper-tab (unmod (lctl lalt) f1)
)

(deflayer base
  @esc
  tab
  @caps
  @spc
)

(deflayer hyper
  _
  @hyper-tab
  _
  _
)
